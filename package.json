{
  "name": "pila",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "pnpm --parallel --filter pila-fe --filter @pila/api dev",
    "dev:api": "pnpm --filter @pila/api dev",
    "dev:web": "pnpm --filter pila-fe dev",
    "lint": "pnpm -r --if-present lint",
    "start:api": "pnpm --filter @pila/api start",
    "start:web": "pnpm --filter pila-fe start",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.25.0"
}
